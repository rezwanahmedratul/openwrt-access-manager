# ==============================================================================
# OpenWrt Access Manager — Environment Variables Example
# ==============================================================================
# Copy this file to .env.local for local development or configure these variables
# in your Vercel Project Settings for production deployment.

# ------------------------------------------------------------------------------
# Supabase Configuration
# ------------------------------------------------------------------------------
# Your Supabase Project URL (found in Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase Publishable / Anon API Key (safe for client-side usage)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-here

# Supabase Service Role Key (SERVER-ONLY — never expose to client or prefix with NEXT_PUBLIC_)
# Used by Next.js API route handlers to perform privileged database operations and bypass RLS
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ------------------------------------------------------------------------------
# Authentication & Security Secrets
# ------------------------------------------------------------------------------
# Cryptographic secret key used to sign and verify user session tokens (JWT via jose)
# MUST be at least 32 characters long in production. Generate with: openssl rand -base64 32
SESSION_SECRET=your-strong-cryptographic-session-secret-min-32-chars

# Dedicated router authentication token (shared between server and OpenWrt router script)
# Used by the router sync script (/root/sync-config.sh) for Bearer authentication.
# Generate with: openssl rand -hex 32
# Note: Dynamic token rotation and revocation is also supported through the admin UI.
ROUTER_SECRET=your-secure-random-router-auth-secret-token

# ------------------------------------------------------------------------------
# Optional Infrastructure
# ------------------------------------------------------------------------------
# Redis connection URL (Optional — if omitted or unavailable, the application operates
# directly with Supabase PostgreSQL as the single source of truth with sub-second queries)
# REDIS_URL=redis://127.0.0.1:6379
